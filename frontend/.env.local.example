# Frontend configuration (copy to .env.local). All values are optional.
# Vite only exposes variables that start with VITE_.

# API to call. Defaults to the live deployed API; point it at a local backend
# while developing it, e.g. http://localhost:8000
VITE_API_BASE_URL=

# Only needed if the backend sets API_KEY.
VITE_API_KEY=

# Force the built-in demo data instead of calling the API.
VITE_USE_MOCK_API=false
